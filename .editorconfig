root = true

# Layout of every file. The code rules come from Phantom.Engine.Build's global analyzer config.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,xml,csproj,props,targets,slnx,runsettings,config}]
indent_size = 2

# The header every C# file starts with (IDE0073). The architecture tests check the other code files against the
# same line (tests/Phantom.Relay.Architecture.Tests/Repository/RelayPolicy.cs).
[*.cs]
file_header_template = Copyright (c) 2026 Phantom.Relay. All rights reserved.
