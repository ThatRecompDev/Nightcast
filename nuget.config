<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Phantom.Engine's local feed (Phantom.Engine docs/architecture/packages.md). This checkout sits two folders
       above the engine's; move both side by side and this becomes ../Phantom.Engine/artifacts/packages. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="phantom-engine" value="../Documents/Repositories/Phantom.Engine/artifacts/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="phantom-engine">
      <package pattern="Phantom.Engine.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
