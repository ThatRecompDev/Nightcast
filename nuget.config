<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Phantom.Engine's packages are kept in the repository (vendor/nuget), so a clone restores without the engine's
       checkout; scripts/build/vendor-engine.ps1 copies the pinned version's set there from the engine's local feed
       (Phantom.Engine docs/architecture/packages.md) when the pin moves. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="phantom-engine" value="vendor/nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="phantom-engine">
      <package pattern="Phantom.Engine.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
