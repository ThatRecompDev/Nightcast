# commit-msg: the subject reads "Area: what changed" and nothing attributes the commit to an AI.
# The rules are in docs/how-we-work.md (Phantom.Engine's rulebook, section 3).
set -u

max_subject_length=100

fail() {
    printf 'commit-msg: %s\n' "$1" >&2

    exit 1
}

message_file="$1"
subject=$(sed -n '1p' "$message_file")

if ! printf '%s\n' "$subject" | grep -qE '^[A-Z][A-Za-z0-9+./ -]*: [^ ].*[^.]$'; then
    fail "the subject must read 'Area: what changed' without a trailing period: $subject"
fi

if [ "${#subject}" -gt "$max_subject_length" ]; then
    fail "the subject is longer than $max_subject_length characters"
fi

if grep -qiE '^co-authored-by:' "$message_file"; then
    fail "no Co-Authored-By lines"
fi

if grep -qiE 'generated (with|by) .*(claude|copilot|chatgpt|gpt|ai)|claude\.com|noreply@anthropic\.com|^co-authored' "$message_file"; then
    fail "no AI attribution in commit messages"
fi

exit 0
