<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Phantom.Engine.Testing" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Phantom.Relay.Desktop/Phantom.Relay.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The decoder's tests' synthetic H.264 stream and the frame generation's test logger, for the GPU path's live checks. -->
  <ItemGroup>
    <Compile Include="../Phantom.Relay.Media.Windows.Tests/SyntheticH264Encoding.cs" Link="Live/SyntheticH264Encoding.cs" />
    <Compile Include="../Phantom.Relay.Lsfg.Tests/Live/TestOutputLogger.cs" Link="Live/TestOutputLogger.cs" />
  </ItemGroup>

  <!-- The recording's live checks write where the encoder's do and decode the shown file the same way. -->
  <ItemGroup>
    <Compile Include="../Phantom.Relay.Media.Windows.Tests/Recording/RecordingTestFolder.cs" Link="Live/RecordingTestFolder.cs" />
    <Compile Include="../Phantom.Relay.Media.Windows.Tests/Recording/DecodedLuma.cs" Link="Live/DecodedLuma.cs" />
  </ItemGroup>

</Project>