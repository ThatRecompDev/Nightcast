<Project Sdk="Microsoft.NET.Sdk">

  <!-- Optional, Windows-only, off by default: Lossless Scaling's frame generation (LSFG) on the decoder's D3D11
       device. Nothing of Lossless Scaling is in this repository: its shaders are read at run time from the owner's
       own install (Lossless.dll), under the owner's personal-use permission. docs/architecture/lsfg.md -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Phantom.Engine.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Phantom.Relay.Media.Windows/Phantom.Relay.Media.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Phantom.Relay.Lsfg.Tests" />
  </ItemGroup>

</Project>