<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows hardware H.264 decoder behind Phantom.Engine's IVideoDecoder: Media Foundation's decoder on DXVA,
       reached through source-generated COM (GeneratedComInterface, LibraryImport), so it is NativeAOT-safe. Its
       bitstream and picture helpers (Annex-B units, the SPS's colour, NV12 to planes) are game-agnostic and engine
       candidates. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Phantom.Engine.Core" />
    <PackageReference Include="Phantom.Engine.Media" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Phantom.Relay.Media.Windows.Tests" />
    <!-- The frame generation runs on the decoder's D3D11 device and shares these COM definitions (one per mechanic). -->
    <InternalsVisibleTo Include="Phantom.Relay.Lsfg" />
    <InternalsVisibleTo Include="Phantom.Relay.Lsfg.Tests" />
    <!-- NVIDIA's FRUC, the second frame generator, shares them too (its textures, its fence). -->
    <InternalsVisibleTo Include="Phantom.Relay.Nvidia" />
    <InternalsVisibleTo Include="Phantom.Relay.Nvidia.Tests" />
    <!-- The decoder's GPU path end to end (its synthetic H.264 encoder uses the Media Foundation interop). -->
    <InternalsVisibleTo Include="Phantom.Relay.Desktop.Tests" />
  </ItemGroup>

</Project>
